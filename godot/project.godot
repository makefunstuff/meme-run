; Meme Run — Godot edition
; Engine configuration. Anything that can be built in code is not stored here.

config_version=5

[application]

config/name="Meme Run"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; Compatibility (OpenGL/WebGL2) is not a downgrade here, it is a requirement:
; the game ships as a web build, and Forward+ does not exist in WebGL2. Building
; against the same renderer desktop and web means what you tune is what ships.
; Glow is therefore faked with additive light sprites rather than depending on
; Environment glow, which keeps the look identical on every target.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.09, 0.18, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[debug]

; Variant-inference warnings are noise in a codebase that talks to Nodes it
; owns; genuine type errors are still hard errors.
gdscript/warnings/treat_warnings_as_errors=false
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
